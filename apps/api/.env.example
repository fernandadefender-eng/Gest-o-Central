# Copie para .env e preencha. O .env nunca deve ser commitado nem compartilhado.

# Banco de dados
DATABASE_URL="postgresql://atendimento:atendimento@localhost:5432/atendimento"

# Fila (Redis) — usado pelo BullMQ para processar mensagens assincronamente
REDIS_URL="redis://localhost:6379"

# Autenticação — a API não sobe com segredo ausente ou curto
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""            # 32+ caracteres
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""        # 10+ caracteres, letras e números

# Webhook do WhatsApp (Z-API) — vai no final da URL configurada na Z-API: ?token=...
WEBHOOK_TOKEN=""         # 24+ caracteres aleatórios

# IA (Claude) — classifica as conversas em atendimentos
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"

# Custo da IA
USD_BRL_RATE="5.40"
MONTHLY_BUDGET_USD="5.00"   # teto mensal; ao atingir, a IA pausa. 0 = sem limite

# Ritmo da classificação
CLASSIFY_FIRST_DELAY_SECONDS="20"
CLASSIFY_UPDATE_DELAY_SECONDS="300"
CLASSIFY_MAX_WAIT_SECONDS="1800"

# A operação acontece em grupos. Conversas individuais são gravadas, mas só vão
# para a IA se "true" (mais custo e envio de conversas pessoais para a IA).
CLASSIFICAR_CONVERSAS_INDIVIDUAIS="false"

# Rede e segurança
HOST="127.0.0.1"            # 0.0.0.0 abre para a rede local (não recomendado)
PORT=3000
RATE_LIMIT_PER_MIN="600"
GEOCODING_ENABLED="true"    # busca coordenadas de cidades no OpenStreetMap (gratuito)
# CORS_ORIGINS="https://painel.exemplo.com"   # só se o painel for servido em outro domínio
